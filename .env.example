# claude-pilot environment configuration
# Copy to .env and fill in values. Existing os.environ takes precedence.

# GitHub token for PR creation (fine-grained PAT for bot account)
# GH_TOKEN=ghp_xxx

# ── cm heartbeat writer (cpp#111, D8 subsystem 2 client-side) ────────────────
# Posts liveness pings to the control-monitor at natural lifecycle transitions
# (session start, per-turn, tool recovery, session end). Fire-and-forget with
# a 500ms timeout; absent CM_TOKEN silently skips.
# CM_HEARTBEAT_DISABLED=1        # set to disable all heartbeat calls
# CM_HEARTBEAT_ENTITY=pilot      # entity id in the URL path (default: pilot)
# CM_API_URL=http://127.0.0.1:8090   # cm-api base URL (default shown)
# CM_TOKEN=cm-bearer-token       # bearer for cm-api; required to fire

# cpp#151 — how many times one session may be resumed past an
# `error_during_execution` that followed a NON-TERMINAL policy refusal.
# Default 2, hard ceiling 5. `0` — or ANY unparseable value, so `0.0` and
# `false` disable rather than silently re-enable — turns the resume off and
# leaves the observability + the `error_during_execution:after_deny`
# classification in place. Each resume starts a fresh CLI query loop with its
# own maxTurns budget, which is why the ceiling exists.
# CLAUDE_PILOT_MAX_DENY_RESUMES=2
